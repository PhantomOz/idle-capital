    "dev:api": "tsx apps/api/src/server.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
