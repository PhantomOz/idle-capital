{
  "name": "idle-capital",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/obligations && tsc --noEmit -p packages/kernel && tsc --noEmit -p packages/yields && tsc --noEmit -p packages/ledger && tsc --noEmit -p apps/api",
