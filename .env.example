# ── The Graph ──────────────────────────────────────────────────────────────
# Subgraph Studio API key. Blocks both Graph tracks ($10k) if absent.
# Get from https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# ── Anthropic (agent proposer) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Privy ──────────────────────────────────────────────────────────────────
# https://dashboard.privy.io → app settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Arc (Circle) testnet ───────────────────────────────────────────────────
ARC_RPC_URL=
ARC_USDC_ADDRESS=
# Funded testnet key. Never commit the populated .env — it is gitignored.
ARC_PRIVATE_KEY=

# ── Privy server wallet (created via POST /v1/wallets) ─────────────────────
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
# Earn vault configured in the Privy Dashboard. Optional; without it nothing
# parks and the agent works with a fully liquid treasury.
PRIVY_EARN_VAULT_ID=
# Counterparty for the settlement leg on Arc. Defaults to the treasury wallet,
# which makes every settlement a self-transfer — set it to a different account
# you control so the transfer actually moves value. `pnpm demo:refund` sends it
# back from the Arc EOA so the demo can be run repeatedly.
SETTLEMENT_ADDRESS=
# Agent model. Defaults to claude-opus-5.
AGENT_MODEL=

# ── Policy knobs (all optional; defaults in apps/api/src/config.ts) ─────────
# Venues that may RECEIVE funds — not protocols you merely approve of. Naming
# one this deployment has no adapter for authorises a transfer that must fail.
# Default: privy-earn. See DECISIONS.md D-016.
PROTOCOL_ALLOWLIST=
# `testnet` (default) runs the four-currency schedule at 1/2000 so the demo
# reaches settlement; `business` runs the real $12,200 schedule and shows K1
# refusing the whole surplus. See DECISIONS.md D-020.
OBLIGATIONS=
# Kernel movement ceiling per run, USDC minor units. Must stay BELOW the Privy
# wallet policy's per-transaction ceiling. See DECISIONS.md D-015.
MAX_RUN_MOVEMENT_USDC=
BUFFER_HORIZON_DAYS=
BUFFER_MULTIPLIER_BPS=
MAX_VENUE_CONCENTRATION_BPS=
MIN_VENUE_LIQUIDITY_USD=

# ── Process ────────────────────────────────────────────────────────────────
PORT=
LEDGER_PATH=
