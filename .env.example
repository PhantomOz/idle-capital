# ── The Graph ──────────────────────────────────────────────────────────────
# Subgraph Studio API key. Blocks both Graph tracks ($10k) if absent.
# Get from https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# ── Anthropic (agent proposer) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Privy ──────────────────────────────────────────────────────────────────
# https://dashboard.privy.io → app settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Base mainnet ───────────────────────────────────────────────────────────
# Where the treasury holds USDC and where the Earn vault settles. Mainnet, so
# the balances and the yield are real. https://mainnet.base.org works.
BASE_RPC_URL=https://mainnet.base.org

# ── Privy server wallet (created via POST /v1/wallets) ─────────────────────
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
# The Earn vault the agent may deposit into. REQUIRED — the server refuses to
# start without it, because a deployment with no reachable venue used to go on
# producing allocations and "settling" them as transfers to itself. D-024.
#   q52e74l43z9plkapivrldsq3 = "Steakhouse Prime USDC" (Morpho, Base), 3.96% APY
PRIVY_EARN_VAULT_ID=q52e74l43z9plkapivrldsq3
# The vault's contract address. Needed at onboarding, not just at execution:
# Privy policies deny by default, so a wallet is provisioned with this address
# allowlisted or it cannot deposit anywhere at all.
PRIVY_EARN_VAULT_ADDRESS=0xa6d1811a72a1cc1a4d536c4476c56da8d234d38d
# Agent model. Defaults to claude-opus-5.
AGENT_MODEL=

# ── Policy knobs (all optional; defaults in apps/api/src/config.ts) ─────────
# Venues that may RECEIVE funds — not protocols you merely approve of. Naming
# one this deployment has no adapter for authorises a transfer that must fail.
# Default: privy-earn. See DECISIONS.md D-016.
PROTOCOL_ALLOWLIST=
# `testnet` (default) runs the four-currency schedule at 1/2000 so the demo
# reaches settlement; `business` runs the real $12,200 schedule and shows K1
# refusing the whole surplus. See DECISIONS.md D-020.
OBLIGATIONS=
# Kernel movement ceiling per run, USDC minor units. Must stay BELOW the Privy
# wallet policy's per-transaction ceiling. See DECISIONS.md D-015.
MAX_RUN_MOVEMENT_USDC=
BUFFER_HORIZON_DAYS=
BUFFER_MULTIPLIER_BPS=
MAX_VENUE_CONCENTRATION_BPS=
MIN_VENUE_LIQUIDITY_USD=
# K9: the least a venue must earn over BUFFER_HORIZON_DAYS, in basis points of
# the amount deployed. Default 5 — about a 0.61% APY floor at a 30-day horizon.
# This is the invariant that refuses a venue which pays nothing. D-024.
MIN_NET_YIELD_BPS=

# ── Process ────────────────────────────────────────────────────────────────
PORT=
LEDGER_PATH=
